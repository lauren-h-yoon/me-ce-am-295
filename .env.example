# ===== ME/CE/AM 295 course infra — environment =====
# Copy to .env and fill in. NEVER commit .env.

# --- AI backend (Claude Agent SDK → spawns the Claude Code CLI) ---
# Install the CLI (needs Node):  npm install -g @anthropic-ai/claude-code
# Pick ONE auth path:
#   A) Subscription (Pro/Max) — dev/prototyping. Run `claude setup-token` and paste:
CLAUDE_CODE_OAUTH_TOKEN=
#   B) Pay-per-use API key — recommended for multi-user production:
# ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=sonnet                       # Claude Code CLI model alias (sonnet|opus|haiku)

# --- Optional: semantic-search upgrade (pgvector). Not needed for native retrieval. ---
# VOYAGE_API_KEY=pa-...
# VOYAGE_EMBED_MODEL=voyage-3
# DATABASE_URL=postgresql://localhost:5432/me_ce_am_295

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...      # Socket Mode
SLACK_SIGNING_SECRET=...

# --- Course gating ---
# Leave unset to derive the current teaching week from the calendar (pipeline/config.py).
# Set explicitly (e.g. CURRENT_WEEK=3) to override for testing.
# CURRENT_WEEK=1
